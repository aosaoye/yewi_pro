NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
APP_NAME=Yewi Marketplace API
PUBLIC_APP_URL=https://yewi.app
CORS_ORIGIN=*
ENABLE_SWAGGER=true

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/yewi
DATABASE_RUN_MIGRATIONS=false

REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

JWT_SECRET=change_this_to_a_long_random_jwt_secret_key
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=change_this_to_a_long_random_refresh_secret_key
JWT_REFRESH_EXPIRATION=7d

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_CLIENT_IDS=

CLERK_SECRET_KEY=
CLERK_JWKS_URL=
CLERK_ISSUER=
CLERK_AUTHORIZED_PARTY=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=

STREAM_API_KEY=
STREAM_API_SECRET=

STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

PLATFORM_COMMISSION_PERCENTAGE=15
MAX_PROS_PER_LEAD=5
AUTO_COMPLETE_ORDER_DAYS=3
DEFAULT_CREDIT_PRICE_EUR=1.0
