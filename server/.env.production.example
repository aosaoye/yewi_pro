# ==============================================================================
# Yewi Marketplace API - Render / Production Environment Template
# Copia estas variables en Render Dashboard -> Environment (o usa render.yaml)
# ==============================================================================

# App Config (Render inyecta PORT automáticamente; no hace falta fijarlo a 3000)
NODE_ENV=production
API_PREFIX=api/v1
APP_NAME=Yewi Marketplace API
PUBLIC_APP_URL=https://yewi.app
API_PUBLIC_URL=https://tu-servicio.onrender.com
ENABLE_SWAGGER=true

# Database (PostgreSQL - Internal URL de Render, o External/Supabase/Neon con SSL)
DATABASE_URL=postgresql://user:password@host:5432/yewi_db
DATABASE_SSL=false
DATABASE_RUN_MIGRATIONS=true

# Redis (OBLIGATORIO en NODE_ENV=production - Render Key Value o Upstash)
REDIS_URL=redis://default:password@host:6379

# Security & JWT (Mínimo 16 caracteres; usa claves aleatorias largas en producción)
JWT_SECRET=cambia_esto_por_un_secreto_aleatorio_min_32_caracteres
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=cambia_esto_por_otro_secreto_aleatorio_min_32_caracteres
JWT_REFRESH_EXPIRATION=7d

# Throttling & Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# CORS (En NODE_ENV=production NO puede ser '*')
CORS_ORIGIN=https://yewi.app,http://localhost:8081,http://localhost:19006,http://localhost:5173

# Business Rules
PLATFORM_COMMISSION_PERCENTAGE=15
MAX_PROS_PER_LEAD=5
AUTO_COMPLETE_ORDER_DAYS=3
DEFAULT_CREDIT_PRICE_EUR=1.0

# Stripe (OBLIGATORIO en NODE_ENV=production)
STRIPE_SECRET_KEY=sk_test_o_live_tu_clave
STRIPE_WEBHOOK_SECRET=whsec_tu_webhook_secret
STRIPE_PRO_PRICE_ID=

# Storage (En Render el disco es efímero: usar cloudinary)
STORAGE_DRIVER=cloudinary
STORAGE_LOCAL_PATH=./uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# OAuth / Auth externa (Opcional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_CLIENT_IDS=
CLERK_SECRET_KEY=
CLERK_JWKS_URL=
CLERK_ISSUER=
CLERK_AUTHORIZED_PARTY=

# Twilio OTP (Opcional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Stream Chat (Opcional)
STREAM_API_KEY=
STREAM_API_SECRET=

# Redsys (Opcional)
REDSYS_MERCHANT_CODE=
REDSYS_TERMINAL=001
REDSYS_SECRET_KEY=
REDSYS_ENV=test
