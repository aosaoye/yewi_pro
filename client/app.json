{
  "expo": {
    "name": "Yewi",
    "slug": "yewi-pro",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "yewi",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSFaceIDUsageDescription": "Usa Face ID para iniciar sesión de forma rápida y segura en Yewi.",
        "NSLocationWhenInUseUsageDescription": "Usa tu ubicación para encontrar profesionales cercanos y autocompletar direcciones.",
        "NSCameraUsageDescription": "Permite capturar fotos de trabajos, portafolio o verificaciones.",
        "NSPhotoLibraryUsageDescription": "Permite adjuntar imágenes desde tu galería."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F8FAFC",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F8FAFC",
          "dark": {
            "backgroundColor": "#09090B"
          }
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-local-authentication",
      "expo-location",
      "expo-image-picker",
      "expo-notifications",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "69cb9d7b-7abc-42a3-8c64-c642f8fcc583"
      }
    },
    "owner": "22osaoye"
  }
}
